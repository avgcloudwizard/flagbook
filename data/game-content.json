{
  "version": 1,
  "checked": "2026-10-23",
  "culture": {
    "in": {
      "category": "Tradition",
      "text": "Yoga, with its poses, breathing and meditation, originated here.",
      "source": "https://ich.unesco.org/en/RL/yoga-01163"
    },
    "br": {
      "category": "Dance & sport",
      "text": "Capoeira brings music, dance and martial arts together in a circle.",
      "source": "https://ich.unesco.org/en/RL/capoeira-circle-00892"
    },
    "cn": {
      "category": "Food & drink",
      "text": "Tea-making and tea-sharing traditions are part of everyday social life here.",
      "source": "https://ich.nlc.cn/unesco/detail/27"
    },
    "pe": {
      "category": "Food",
      "text": "Ceviche — fish marinated with citrus and chilli — is a celebrated local dish.",
      "source": "https://ich.unesco.org/en/RL/ceviche-an-expression-of-traditional-peruvian-cuisine-01952"
    },
    "mx": {
      "category": "Food",
      "text": "Corn, beans and chilli underpin a cuisine known for tortillas and tamales.",
      "source": "https://ich.unesco.org/en/RL/traditional-mexican-cuisine-00400"
    },
    "ci": {
      "category": "Food",
      "text": "Attiéké, a steamed cassava dish, is a staple at family meals and celebrations.",
      "source": "https://ich.unesco.org/en/RL/skills-related-to-attieke-production-in-cote-d-ivoire-02086"
    },
    "gh": {
      "category": "Music & dance",
      "text": "Highlife music and dance blend local rhythms with influences from brass bands and other musical traditions.",
      "source": "https://unescoghana.gov.gh/intangible-cultural-heritage/"
    },
    "cd": {
      "category": "Music & dance",
      "text": "Rumba is a major music-and-dance tradition here, shared with the neighbouring Republic of the Congo.",
      "source": "https://ich.unesco.org/en/RL/congolese-rumba-01711"
    },
    "id": {
      "category": "Sport & tradition",
      "text": "Pencak silat combines martial arts, self-defence, music and movement.",
      "source": "https://ich.unesco.org/en/RL/traditions-of-pencak-silat-01391"
    },
    "ca": {
      "category": "Sport",
      "text": "Ice hockey is the official winter sport; lacrosse is the official summer sport.",
      "source": "https://laws-lois.justice.gc.ca/eng/acts/n-16.7/page-1.html"
    },
    "au": {
      "category": "Sport",
      "text": "Cricket, rugby and a home-grown code of football are popular here.",
      "source": "https://www.dfat.gov.au/about-australia"
    },
    "sa": {
      "category": "Dance",
      "text": "Alardah Alnajdiyah brings dance, drumming and poetry together.",
      "source": "https://ich.unesco.org/en/state/saudi-arabia-SA"
    },
    "ua": {
      "category": "Food",
      "text": "Borscht cooking is a cherished tradition here, recognised by UNESCO.",
      "source": "https://ich.unesco.org/en/ukraine-request-17com-4bur-01262"
    },
    "co": {
      "category": "Music",
      "text": "Traditional vallenato combines the accordion, caja drum and guacharaca scraper.",
      "source": "https://ich.unesco.org/doc/src/29941.pdf"
    },
    "vn": {
      "category": "Food",
      "text": "Phở, a rice-noodle soup with beef or chicken and herbs, is often eaten for breakfast here.",
      "source": "https://vietnam.travel/things-to-do/must-try-noodles-vietnam"
    },
    "fr": {
      "category": "Food",
      "text": "The baguette, made with flour, water, salt and yeast or leaven, is a familiar bakery staple.",
      "source": "https://ich.unesco.org/en/RL/artisanal-know-how-and-culture-of-baguette-bread-01883"
    },
    "ar": {
      "category": "Dance",
      "text": "Tango grew in the Río de la Plata region; the tradition is shared with Uruguay.",
      "source": "https://ich.unesco.org/en/rl/tango-00258"
    },
    "cl": {
      "category": "Dance",
      "text": "The cueca is our national dance, with regional variations across the country.",
      "source": "https://www.memoriachilena.gob.cl/602/w3-article-3510.html"
    },
    "ir": {
      "category": "Celebration",
      "text": "Nowruz marks the spring new year here, a celebration shared with several neighbouring cultures.",
      "source": "https://www.unesco.org/en/days/nowruz"
    }
  },
